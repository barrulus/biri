// rainbow colour-tunnel inside an adaptive cursor ring — concentric rainbow bands
// flow inward to the mouse point (hypnotic), semi-transparent so the desktop stays
// readable; the luminance-adaptive blue ring + glow (from global-adaptive) sit on top
global-shader {
    enable
    source "vec4 global_color(vec3 c){
        vec3 s  = tex2D_screen(c.xy).rgb;
        vec2 px = c.xy*niri_size;
        float d = length(px - niri_cursor);

        // rainbow tunnel inside the ring — concentric bands flowing inward
        float t = d*0.07 + niri_time*1.0;                                 // inward flow (toward cursor)
        vec3 tunnel = 0.5 + 0.5*cos(6.2831853*(t + vec3(0.0,0.33,0.67))); // IQ rainbow palette
        float fill  = smoothstep(54.0, 50.0, d);                          // fill interior, fade at rim
        vec3 outc   = mix(s, tunnel, fill*0.09);                          // light, see-through blend

        // adaptive luminance ring + glow, drawn on top
        float ring = smoothstep(7.0,0.0,abs(d-55.0));
        float glow = smoothstep(110.0,0.0,d)*0.3;
        float lum  = dot(s, vec3(0.299,0.587,0.114));
        vec3 ringCol = mix(vec3(0.35,0.75,1.0), vec3(0.0,0.1,0.45), smoothstep(0.4,0.6,lum));
        float m = clamp(ring+glow,0.0,1.0);

        return vec4(mix(outc, ringCol, m*0.9), 1.0);
    }"
}
